# Per-app values for the shared pipeline in gi-os/.github (ios/README.md lists every key).
# Plain KEY="value" lines, no quotes inside values: fastlane reads this file too. No secrets.
APP_NAME="Supernote"
SCHEME="SupernoteIOS"
TARGETS="SupernoteIOS:com.gios.supernoteios"
# Built with the iOS 27.1 SDK so the iPhone Duo runs it full screen on both displays.
RUNNER="xcode-27"
XCODE="27.1"
# NoteKit and SyncKit are tested as a Swift package; the app target has no XCTest bundle.
PRE_TEST="swift test"
XCTEST="false"
APP_GROUP=""
PUSH_BUNDLE=""
THIRD_PARTY_CONTENT="false"
EXTERNAL_GROUPS=""
